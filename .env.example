TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_API_GATEWAY=https://eco.taobao.com/router/rest
TAOBAO_API_METHOD=taobao.time.get

# Fill this only when testing an API that requires seller/user authorization.
TAOBAO_SESSION=

# Public Xianyu sync. Replace HTTP with HTTPS after the certificate is enabled.
VITE_XIANYU_API_BASE_URL=http://www.wmzh.online
VITE_XIANYU_API_TIMEOUT_MS=20000

# Reuses the shared MySQL connection used by the Node API.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
AUTH_TOKEN_SECRET=
XIANYU_MYSQL_RECORD_TABLE=xianyu_records
XIANYU_MYSQL_IMAGE_TABLE=xianyu_record_images

# Generate a unique random secret of at least 32 bytes. Never commit the real value.
XIANYU_ENCRYPTION_SECRET=
