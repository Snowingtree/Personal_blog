# Standalone Node API service port.
API_PORT=3001
API_HOST=127.0.0.1

# Allow browser access from another origin. Use "*" for development or set your site domain.
CORS_ORIGIN=*

# Vite dev server forwards /api to this address.
API_PROXY_TARGET=http://127.0.0.1:3001

# Optional: when the built frontend cannot share the same origin with the API,
# set an absolute backend URL such as http://8.148.65.159:3001
VITE_API_BASE_URL=

# Optional: treat these custom domains as private-app hosts in the frontend.
# Example: VITE_PRIVATE_APP_ALLOWED_HOSTS=example.com,www.example.com
VITE_PRIVATE_APP_ALLOWED_HOSTS=

# "file" or "mysql". When omitted, MySQL is used only if the
# required MYSQL_* variables are present; otherwise the app falls back to anime.txt.
ANIME_STORAGE=mysql

# "file" or "mysql". When omitted, MySQL is used only if the
# required MYSQL_* variables are present; otherwise the app falls back to blog-checkins.json.
BLOG_CHECKIN_STORAGE=mysql
BLOG_CHECKIN_MYSQL_TABLE=blog_checkins
BLOG_CHECKIN_TIME_ZONE=Asia/Shanghai

# Absolute path to the cloned GitHub notes repository on the server.
# Example: /www/wwwroot/note_笔记本
NOTE_REPO_PATH=

# OpenAI-compatible API settings used by /api/ai/notes-quiz
# The frontend must send an explicit model in each notes-quiz request.
# AI config rows stored in the database should provide their own interface URL.
# OPENAI_BASE_URL is only used by legacy env-key mode when OPENAI_API_KEY_STORAGE=env.
# OPENAI_API_KEY_STORAGE can be "env" or "mysql". When omitted, the server
# uses OPENAI_API_KEY first, and falls back to MySQL when no env key is set.
# OPENAI_API_ENDPOINT_STYLE can be "responses" or "chat_completions".
# When omitted, the server auto-detects: bigmodel.cn uses chat_completions,
# other providers default to responses.
OPENAI_API_KEY_STORAGE=env
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_ENDPOINT_STYLE=
OPENAI_TIMEOUT_MS=45000
OPENAI_CURRENT_FILE_MAX_CHARS=12000
OPENAI_MEMORY_FILE_MAX_CHARS=8000

# Optional MySQL table for storing OpenAI-compatible API keys.
# Used when OPENAI_API_KEY_STORAGE=mysql, or automatically when no env key is set.
# When the OPENAI_KEY_MYSQL_* / AI_SETTINGS_MYSQL_* connection values are omitted,
# the shared MYSQL_* settings below are used.
# OPENAI_KEY_ENCRYPTION_SECRET is optional but recommended. When present,
# values stored as enc:v1:... in OPENAI_API_KEY, ai_api_keys.api_key, or
# AI settings api_key values will be decrypted server-side before use.
OPENAI_KEY_ENCRYPTION_SECRET=
OPENAI_KEY_MYSQL_HOST=
OPENAI_KEY_MYSQL_PORT=
OPENAI_KEY_MYSQL_USER=
OPENAI_KEY_MYSQL_PASSWORD=
OPENAI_KEY_MYSQL_DATABASE=
OPENAI_KEY_MYSQL_TABLE=ai_api_keys

# Optional MySQL table for the private AI settings admin page.
# When AI_SETTINGS_MYSQL_* values are omitted, the shared MYSQL_* settings below are used.
AI_SETTINGS_MYSQL_HOST=
AI_SETTINGS_MYSQL_PORT=
AI_SETTINGS_MYSQL_USER=
AI_SETTINGS_MYSQL_PASSWORD=
AI_SETTINGS_MYSQL_DATABASE=
AI_SETTINGS_MYSQL_TABLE=ai_provider_configs

# MySQL connection settings used by the standalone Node API.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=myFiles
MYSQL_TABLE=anime_items

# Login table settings for POST /api/login
# Optional: set AUTH_MYSQL_* only when the users table lives in a different database
# or needs a different MySQL account. When omitted, auth falls back to MYSQL_* above.
AUTH_MYSQL_HOST=
AUTH_MYSQL_PORT=
AUTH_MYSQL_USER=
AUTH_MYSQL_PASSWORD=
AUTH_MYSQL_DATABASE=
AUTH_USER_TABLE=users
AUTH_USER_ID_COLUMN=id
AUTH_USERNAME_COLUMN=username
AUTH_PASSWORD_COLUMN=password

# Authentication token settings used by protected anime / notes APIs.
# Use a long random string in production. 86400 = 24 hours.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_SECONDS=86400
